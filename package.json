{
  "name": "simple-linkedin-composer",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write package.json pnpm-workspace.yaml *.config.js .github/dependabot.yml src/main.js",
    "format:check": "prettier --check package.json pnpm-workspace.yaml *.config.js .github/dependabot.yml src/main.js",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:html && pnpm lint:md",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "htmlhint \"src/**/*.html\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\"",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "datatables.net": "1.13.11",
    "datatables.net-dt": "1.13.11",
    "emoji-picker-element": "1.29.1",
    "jquery": "4.0.0",
    "quill": "2.0.3",
    "toastr": "2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "htmlhint": "1.9.2",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
