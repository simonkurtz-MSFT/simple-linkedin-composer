{
  "name": "simple-linkedin-composer",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "hooks:install": "node scripts/install-hooks.mjs",
    "lockfile:normalize": "node scripts/normalize-pnpm-lock.mjs",
    "lockfile:check": "node scripts/normalize-pnpm-lock.mjs --check",
    "format": "prettier --write package.json pnpm-workspace.yaml *.config.js .github/dependabot.yml src/**/*.js scripts/**/*.mjs tests/**/*.js",
    "format:check": "prettier --check package.json pnpm-workspace.yaml *.config.js .github/dependabot.yml src/**/*.js scripts/**/*.mjs tests/**/*.js",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:html && pnpm lint:md",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "htmlhint \"src/**/*.html\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\"",
    "test": "vitest run --root . --passWithNoTests",
    "test:browser": "playwright test",
    "test:browser:ci": "playwright test --ignore-snapshots",
    "test:browser:update": "playwright test --update-snapshots",
    "check": "pnpm lockfile:check && pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "quill": "2.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "htmlhint": "1.9.2",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
